<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kvalik2Proj.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="680"
             x:Class="Kvalik2Proj.Views.UsersListView"
             x:DataType="vm:UsersListViewModel">

    <Grid Margin="30,20" RowDefinitions="Auto,Auto,*,Auto">

        <TextBlock Grid.Row="0" Text="Управление пользователями"
                   FontSize="22" FontWeight="Bold" Margin="0,0,0,15"/>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <TextBox Grid.Column="0" Text="{Binding SearchText}"
                     Watermark="Поиск по имени или email..."
                     Margin="0,0,15,0" FontSize="14"/>
            <Button Grid.Column="1" Content="+ Добавить сотрудника"
                    Command="{Binding AddEmployeeCommand}"
                    Padding="15,8" FontSize="14"/>
        </Grid>
        <Border Grid.Row="2" Background="White" CornerRadius="8"
                BorderBrush="#DDD" BorderThickness="1">
            <Grid RowDefinitions="Auto,*">
                <Border Grid.Row="0" Background="#E8E8E8" Padding="10,8">
                    <Grid ColumnDefinitions="60,*,*,150,100,80">
                        <TextBlock Grid.Column="0" Text="ID" FontWeight="Bold" FontSize="13"/>
                        <TextBlock Grid.Column="1" Text="Имя" FontWeight="Bold" FontSize="13"/>
                        <TextBlock Grid.Column="2" Text="Email" FontWeight="Bold" FontSize="13"/>
                        <TextBlock Grid.Column="3" Text="Роль" FontWeight="Bold" FontSize="13"/>
                        <TextBlock Grid.Column="4" Text="Баланс" FontWeight="Bold" FontSize="13"/>
                        <TextBlock Grid.Column="5" Text="" FontWeight="Bold" FontSize="13"/>
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding Users}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:UserItemViewModel">
                                <Border Padding="10,6" BorderBrush="#EEE" BorderThickness="0,0,0,1">
                                    <Grid ColumnDefinitions="60,*,*,150,100,80">
                                        <TextBlock Grid.Column="0" Text="{Binding Id}" 
                                                   VerticalAlignment="Center" FontSize="13"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" 
                                                   VerticalAlignment="Center" FontSize="13"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Email}" 
                                                   VerticalAlignment="Center" FontSize="13"/>
                                        <ComboBox Grid.Column="3" 
                                                  ItemsSource="{Binding AvailableRoles}"
                                                  SelectedItem="{Binding SelectedRole}"
                                                  DisplayMemberBinding="{Binding Name}"
                                                  FontSize="12" Width="140"
                                                  VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" 
                                                   Text="{Binding Balance, StringFormat={}{0:N2}}"
                                                   VerticalAlignment="Center" FontSize="13"/>
                                        <Button Grid.Column="5" Content="Удалить"
                                                Command="{Binding DeleteCommand}"
                                                Padding="6,3" FontSize="11"
                                                Background="#C42B1C" Foreground="White"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
        <StackPanel Grid.Row="3" Orientation="Horizontal" 
                    HorizontalAlignment="Center" Margin="0,10,0,0" Spacing="15">
            <Button Content="← Назад" Command="{Binding PreviousPageCommand}"
                    Padding="12,6" FontSize="13"/>
            <TextBlock Text="{Binding PageInfo}" VerticalAlignment="Center" FontSize="14"/>
            <Button Content="Вперёд →" Command="{Binding NextPageCommand}"
                    Padding="12,6" FontSize="13"/>
        </StackPanel>
    </Grid>

</UserControl>

