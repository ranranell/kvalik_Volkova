<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kvalik2Proj.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="680"
             x:Class="Kvalik2Proj.Views.MyAppointmentsView"
             x:DataType="vm:MyAppointmentsViewModel">

    <Grid RowDefinitions="Auto,*,Auto" Margin="20">

        <TextBlock Grid.Row="0" Text="Мои записи" FontSize="22" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,5,0,15"/>
        <Border Grid.Row="1" BorderBrush="#CCC" BorderThickness="1" CornerRadius="8"
                Background="White" Padding="15">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="0">
                    <Border Background="#2D2D2D" CornerRadius="6,6,0,0" Padding="12,10">
                        <Grid ColumnDefinitions="*,*,120,80,100">
                            <TextBlock Grid.Column="0" Text="Услуга" Foreground="White" 
                                       FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Grid.Column="1" Text="Мастер" Foreground="White" 
                                       FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Grid.Column="2" Text="Дата" Foreground="White" 
                                       FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Grid.Column="3" Text="Очередь" Foreground="White" 
                                       FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Grid.Column="4" Text="Статус" Foreground="White" 
                                       FontWeight="SemiBold" FontSize="13"/>
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Appointments}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AppointmentItemViewModel">
                                <Border BorderBrush="#EEE" BorderThickness="0,0,0,1" Padding="12,10"
                                        Background="#FAFAFA">
                                    <Grid ColumnDefinitions="*,*,120,80,100">
                                        <TextBlock Grid.Column="0" Text="{Binding ServiceName}" 
                                                   FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding MasterName}" 
                                                   FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Date}" 
                                                   FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding QueueNumber}" 
                                                   FontSize="13" VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding Status}" 
                                                   FontSize="13" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,*" Margin="0,10,0,0">
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="15">
                <Button Content="◀" Command="{Binding PreviousPageCommand}"
                        FontSize="22" Padding="12,5"
                        Background="#2D2D2D" Foreground="White" CornerRadius="6"/>
                <Border Background="White" CornerRadius="6" Padding="15,6"
                        BorderBrush="#CCC" BorderThickness="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PaginationText}" FontSize="13"/>
                </Border>
                <Button Content="▶" Command="{Binding NextPageCommand}"
                        FontSize="22" Padding="12,5"
                        Background="#2D2D2D" Foreground="White" CornerRadius="6"/>
            </StackPanel>
            <Button Grid.Column="2" Content="Назад" Command="{Binding GoBackCommand}"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Padding="20,8" FontSize="14"
                    Background="Transparent" Foreground="#2D2D2D"
                    BorderBrush="#CCC" BorderThickness="1"/>
        </Grid>
    </Grid>
</UserControl>

