<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kvalik2Proj.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="680"
             x:Class="Kvalik2Proj.Views.ReviewsListView"
             x:DataType="vm:ReviewsListViewModel">

    <Grid RowDefinitions="Auto,*,Auto" Margin="20">

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center"
                    Margin="0,5,0,15" Spacing="15">
            <TextBlock Text="Отзывы" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Content="Написать отзыв" Command="{Binding WriteReviewCommand}"
                    Padding="15,6" FontSize="13"
                    Background="#2D2D2D" Foreground="White" CornerRadius="6"/>
        </StackPanel>
        <Border Grid.Row="1" BorderBrush="#CCC" BorderThickness="1" CornerRadius="8"
                Background="White" Padding="15">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Reviews}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ReviewItemViewModel">
                            <Border BorderBrush="#EEE" BorderThickness="0,0,0,1"
                                    Padding="10,12" Background="#FAFAFA" Margin="0,0,0,5"
                                    CornerRadius="6">
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding AuthorName}" FontWeight="SemiBold"
                                                       FontSize="14"/>
                                            <TextBlock Text="{Binding RatingStars}" FontSize="14"
                                                       Foreground="#E8A317"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Date}"
                                                   FontSize="11" Foreground="Black"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Comment}" FontSize="13"
                                               TextWrapping="Wrap" Foreground="Black"/>
                                    <StackPanel Orientation="Horizontal" Spacing="15">
                                        <TextBlock FontSize="11" Foreground="Black">
                                            <Run Text="Услуга: "/><Run Text="{Binding ServiceName}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="11" Foreground="Black">
                                            <Run Text="Мастер: "/><Run Text="{Binding MasterName}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,*" Margin="0,10,0,0">
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="15">
                <Button Content="◀" Command="{Binding PreviousPageCommand}"
                        FontSize="22" Padding="12,5"
                        Background="#2D2D2D" Foreground="White" CornerRadius="6"/>
                <Border Background="White" CornerRadius="6" Padding="15,6"
                        BorderBrush="#CCC" BorderThickness="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PaginationText}" FontSize="13"/>
                </Border>
                <Button Content="▶" Command="{Binding NextPageCommand}"
                        FontSize="22" Padding="12,5"
                        Background="#2D2D2D" Foreground="White" CornerRadius="6"/>
            </StackPanel>
            <Button Grid.Column="2" Content="Назад" Command="{Binding GoBackCommand}"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Padding="20,8" FontSize="14"
                    Background="Transparent" Foreground="#2D2D2D"
                    BorderBrush="#CCC" BorderThickness="1"/>
        </Grid>
    </Grid>
</UserControl>

