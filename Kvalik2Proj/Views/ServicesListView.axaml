<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kvalik2Proj.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="680"
             x:Class="Kvalik2Proj.Views.ServicesListView"
             x:DataType="vm:ServicesListViewModel">

    <UserControl.Styles>
        <Style Selector="Button.tabActive">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.tabInactive">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="*,200" Margin="15">
        <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto">
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" 
                        Margin="0,5,0,10" Spacing="0">
                <Button Content="Кастом" Command="{Binding ShowCustomTabCommand}"
                        Padding="30,10" FontSize="14" FontWeight="SemiBold"
                        Classes.tabActive="{Binding IsCustomTab}"
                        Classes.tabInactive="{Binding !IsCustomTab}"
                        CornerRadius="6,0,0,6" BorderThickness="0"/>
                <Button Content="Косплей" Command="{Binding ShowCosplayTabCommand}"
                        Padding="30,10" FontSize="14" FontWeight="SemiBold"
                        Classes.tabActive="{Binding IsCosplayTab}"
                        Classes.tabInactive="{Binding !IsCosplayTab}"
                        CornerRadius="0,6,6,0" BorderThickness="0"/>
            </StackPanel>
            <Border Grid.Row="1" BorderBrush="#CCC" BorderThickness="1" CornerRadius="8"
                    Background="White" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Services}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ServiceCardViewModel">
                                <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="6"
                                        Margin="0,0,0,10" Padding="12" Background="#FAFAFA">
                                    <Grid ColumnDefinitions="180,*" MinHeight="130">
                                        <Border Grid.Column="0" Background="#EEE" 
                                                CornerRadius="4" Width="160" Height="120"
                                                ClipToBounds="True"
                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Image Source="{Binding ImageBitmap}"
                                                   Width="160" Height="120"
                                                   Stretch="UniformToFill"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="15,0,0,0"
                                                    VerticalAlignment="Center" Spacing="4">
                                            <TextBlock Text="{Binding Name}" FontSize="16" 
                                                       FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Description}" FontSize="13"
                                                       Foreground="Black" TextWrapping="Wrap"
                                                       MaxLines="2"/>
                                            <TextBlock Text="{Binding Price}" FontSize="14" 
                                                       FontWeight="SemiBold" Foreground="Black"/>
                                            <TextBlock Text="{Binding CategoryName}" FontSize="12" 
                                                       Foreground="Black"/>
                                            <TextBlock Text="{Binding MasterName}" FontSize="12"
                                                       Foreground="Black"/>
                                            <TextBlock Text="{Binding UpdatedAt}" FontSize="11"
                                                       Foreground="Black"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8" 
                                                        Margin="0,4,0,0"
                                                        IsVisible="{Binding IsModerator}">
                                                <Button Content="Редактировать" 
                                                        Command="{Binding EditCommand}"
                                                        Padding="8,4" FontSize="11"
                                                        Background="#2D2D2D" Foreground="White"
                                                        HorizontalAlignment="Left"/>
                                                <Button Content="Удалить" 
                                                        Command="{Binding DeleteCommand}"
                                                        Padding="8,4" FontSize="11"
                                                        Background="#C42B1C" Foreground="White"
                                                        HorizontalAlignment="Left"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            <Border Grid.Row="2" Margin="0,10,0,0" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Border Background="White" CornerRadius="6" Padding="15,6"
                        BorderBrush="#CCC" BorderThickness="1">
                    <TextBlock Text="{Binding PaginationText}" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Border>
        </Grid>
        <StackPanel Grid.Column="1" Margin="15,5,0,0" Spacing="10">
            <TextBox Text="{Binding SearchText}" Watermark="Поиск"
                     Padding="8,6" FontSize="13"/>
            <ComboBox ItemsSource="{Binding Categories}" 
                      SelectedItem="{Binding SelectedCategory}"
                      PlaceholderText="Коллекция"
                      HorizontalAlignment="Stretch" Padding="8,6" FontSize="13"/>
            <Grid ColumnDefinitions="*,*" Margin="0,15,0,0">
                <Button Grid.Column="0" Content="◀" Command="{Binding PreviousPageCommand}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        FontSize="28" Padding="10,5" Margin="0,0,5,0"
                        Background="#2D2D2D" Foreground="White" CornerRadius="6"/>
                <Button Grid.Column="1" Content="▶" Command="{Binding NextPageCommand}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        FontSize="28" Padding="10,5" Margin="5,0,0,0"
                        Background="#2D2D2D" Foreground="White" CornerRadius="6"/>
            </Grid>
            <Button Content="Сортировка А-Я" Command="{Binding ToggleSortCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Padding="8,6" FontSize="12" Margin="0,5,0,0"/>
            <Button Content="Добавить услугу" Command="{Binding AddServiceCommand}"
                    IsVisible="{Binding IsModerator}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Padding="8,8" FontSize="13" Margin="0,15,0,0"
                    Background="#2D7D2D" Foreground="White" CornerRadius="6"/>
        </StackPanel>

    </Grid>
</UserControl>

