<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kvalik2Proj.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="680"
             x:Class="Kvalik2Proj.Views.RegisterView"
             x:DataType="vm:RegisterViewModel">

    <Border Background="#F5F5F5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Border Background="White" CornerRadius="12" Padding="40,30"
                Width="400"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                BoxShadow="0 2 10 0 #30000000">
            <StackPanel Spacing="8" VerticalAlignment="Center">
                
                <Image Source="/Assets/Logo.png" Width="80" Height="60" 
                       Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                
                <TextBlock Text="Регистрация" FontSize="22" FontWeight="Bold" 
                           HorizontalAlignment="Center" Margin="0,0,0,5"/>

                <TextBlock Text="Имя" FontSize="14"/>
                <TextBox Text="{Binding Name}" Watermark="Введите имя" Padding="10,8"/>

                <TextBlock Text="Email" FontSize="14"/>
                <TextBox Text="{Binding Email}" Watermark="Введите email" Padding="10,8"/>

                <TextBlock Text="Пароль" FontSize="14"/>
                <TextBox Text="{Binding Password}" PasswordChar="*" 
                         Watermark="Введите пароль" Padding="10,8"/>

                <TextBlock Text="Подтверждение пароля" FontSize="14"/>
                <TextBox Text="{Binding ConfirmPassword}" PasswordChar="*" 
                         Watermark="Повторите пароль" Padding="10,8"/>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" 
                           FontSize="12" HorizontalAlignment="Center"
                           IsVisible="{Binding ErrorMessage, 
                           Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                <Button Content="Зарегистрироваться" Command="{Binding RegisterCommand}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Padding="10,10" FontSize="15" Margin="0,5,0,0"
                        Background="#2D2D2D" Foreground="White"/>

                <Button Content="Уже есть аккаунт? Войти" Command="{Binding GoToLoginCommand}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Padding="10,8" FontSize="13"
                        Background="Transparent" Foreground="#2D2D2D"
                        BorderBrush="#CCC" BorderThickness="1"/>
            </StackPanel>
        </Border>
    </Border>
</UserControl>

