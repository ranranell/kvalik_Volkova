<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kvalik2Proj.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
        x:Class="Kvalik2Proj.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/Logo.ico"
        Title="Матье"
        Width="1280" Height="720"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="40"
        Background="#F5F5F5">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="40,*">
        <Border Grid.Row="0" Background="#2D2D2D" IsHitTestVisible="True">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" 
                            VerticalAlignment="Center" Margin="10,0">
                    <TextBlock Text="Матье" Foreground="White" FontSize="16" 
                               FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" Margin="0,0,5,0">
                    <Button Content="Свернуть" Click="MinimizeClick" 
                            Background="#555" Foreground="White" 
                            BorderThickness="0" Padding="12,6"
                            FontSize="12" VerticalAlignment="Center"/>
                    <Button Content="Закрыть" Click="CloseClick" 
                            Background="#C42B1C" Foreground="White" 
                            BorderThickness="0" Padding="12,6"
                            FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" ColumnDefinitions="170,*">
            <Border Grid.Column="0" Background="#E8E8E8" 
                    IsVisible="{Binding IsLoggedIn}"
                    BorderBrush="#CCC" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Margin="15,20,15,10"
                            Background="White" CornerRadius="8"
                            Padding="10" HorizontalAlignment="Center">
                        <Image Source="/Assets/Logo.png" Width="120" Height="90"
                               Stretch="Uniform"/>
                    </Border>
                    <StackPanel DockPanel.Dock="Bottom" Margin="10,0,10,20" Spacing="8">
                        <Button Content="Услуги" 
                                Command="{Binding NavigateToServicesCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="10,8" FontSize="14"/>
                        <Button Content="Записаться" 
                                Command="{Binding NavigateToAppointmentCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="10,8" FontSize="14"/>
                        <Button Content="Мои записи" 
                                Command="{Binding NavigateToMyAppointmentsCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="10,8" FontSize="14"/>
                        <Button Content="Баланс" 
                                Command="{Binding NavigateToBalanceCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="10,8" FontSize="14"/>
                        <Button Content="Отзывы" 
                                Command="{Binding NavigateToReviewsCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="10,8" FontSize="14"/>
                        <Button Content="Добавить услугу" 
                                Command="{Binding NavigateToAddServiceCommand}"
                                IsVisible="{Binding IsModerator}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="10,8" FontSize="14"/>
                        <Button Content="Мастера" 
                                Command="{Binding NavigateToMasterBindingCommand}"
                                IsVisible="{Binding IsModerator}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="10,8" FontSize="14"/>
                        <Button Content="Заявки" 
                                Command="{Binding NavigateToQualificationRequestsCommand}"
                                IsVisible="{Binding IsModerator}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="10,8" FontSize="14"/>
                        <Button Content="Пользователи" 
                                Command="{Binding NavigateToUsersCommand}"
                                IsVisible="{Binding IsAdmin}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="10,8" FontSize="14"/>
                        <Button Content="Мой кабинет" 
                                Command="{Binding NavigateToMasterPanelCommand}"
                                IsVisible="{Binding IsMaster}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="10,8" FontSize="14"/>
                        <Button Content="Выход" 
                                Command="{Binding LogoutCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="10,8" FontSize="14"/>
                    </StackPanel>
                    <Border/>
                </DockPanel>
            </Border>
            <ContentControl Grid.Column="1" Content="{Binding CurrentView}" Margin="0"/>
        </Grid>
    </Grid>

</Window>

