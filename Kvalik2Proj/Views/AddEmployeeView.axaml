<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kvalik2Proj.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="680"
             x:Class="Kvalik2Proj.Views.AddEmployeeView"
             x:DataType="vm:AddEmployeeViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Border Margin="30,20" Background="White" CornerRadius="12"
            Padding="40,30" HorizontalAlignment="Center" VerticalAlignment="Top"
            Width="500" BorderBrush="#DDD" BorderThickness="1">
        <StackPanel Spacing="12">
            <TextBlock Text="Добавить сотрудника"
                       FontSize="22" FontWeight="Bold" Margin="0,0,0,10"/>

            <TextBlock Text="Имя" FontSize="14"/>
            <TextBox Text="{Binding Name}" FontSize="14"/>

            <TextBlock Text="Email" FontSize="14"/>
            <TextBox Text="{Binding Email}" FontSize="14"/>

            <TextBlock Text="Пароль" FontSize="14"/>
            <TextBox Text="{Binding Password}" PasswordChar="•" FontSize="14"/>

            <TextBlock Text="Роль" FontSize="14"/>
            <ComboBox ItemsSource="{Binding RoleOptions}"
                      SelectedItem="{Binding SelectedRoleName}"
                      FontSize="14" HorizontalAlignment="Stretch"/>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" FontSize="13"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <StackPanel Orientation="Horizontal" Spacing="15" Margin="0,10,0,0">
                <Button Content="Сохранить" Command="{Binding SaveCommand}"
                        Padding="20,8" FontSize="14"/>
                <Button Content="Отмена" Command="{Binding CancelCommand}"
                        Padding="20,8" FontSize="14"/>
            </StackPanel>
        </StackPanel>
    </Border>
    </ScrollViewer>

</UserControl>

